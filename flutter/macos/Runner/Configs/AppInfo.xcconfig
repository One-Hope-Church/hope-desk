// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// Hope Desk: res/hope-desk/apply-variant.sh rewrites PRODUCT_NAME, PRODUCT_BUNDLE_IDENTIFIER and the two HOPE_DESK_* values below per variant.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = HopeDesk

// Keep the Swift module name stable; Base.lproj/MainMenu.xib references customModule="RustDesk".
PRODUCT_MODULE_NAME = RustDesk

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = org.onehopechurch.hopedesk

HOPE_DESK_DISPLAY_NAME = Hope Desk
HOPE_DESK_URL_SCHEME = hopedesk

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 One Hope, Inc. Based on RustDesk, © Purslane Tech Pte. Ltd. (AGPL-3.0).
